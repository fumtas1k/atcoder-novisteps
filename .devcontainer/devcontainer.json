{
  "name": "atcoder-novisteps",
  // Debian ベース。vscode ユーザーと基本ツールを持つ公式イメージ。
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",

  // タイムゾーンを JST に固定(既定は UTC)。tzdata は同梱済みなので TZ 指定だけで
  // date / Ruby の Time.now などライブラリ時刻がすべて Asia/Tokyo になる。
  "containerEnv": {
    "TZ": "Asia/Tokyo"
  },

  // ランタイムはすべて Features でバージョン固定 → どのマシンでも同じ環境を再現。
  "features": {
    // .ruby-version と一致させる
    "ghcr.io/devcontainers/features/ruby:1": {
      "version": "3.4.5"
    },
    // acc(atcoder-cli) の実行に使う Node.js（atcoder-toolkit はこの npm で acc を入れる）
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    },
    // oj(online-judge-tools) + acc(atcoder-cli) + AtCoder メモリ表記パッチ(api-client PR #173)。
    // 自作 feature: https://github.com/fumtas1k/devcontainer-features
    "ghcr.io/fumtas1k/devcontainer-features/atcoder-toolkit:1": {
      "ojVersion": "11.5.1",
      "apiClientVersion": "10.10.1",
      "accVersion": "2.2.0"
    },
    // 競プロ用 gem をグローバルに焼き込み(ruby feature の後に実行される)。
    // AtCoder のジャッジ環境と同じく Bundler 不要で `ruby main.rb` が動く。
    // gem を増やす/上げるときはここを編集(旧 Gemfile.lock の役割)。
    "ghcr.io/fumtas1k/devcontainer-features/atcoder-ruby:1": {
      "gems": "ac-library-rb@1.2.0 rbtree@0.4.7 numo-narray@0.9.2.1 ruby-lsp"
    },
    // Claude Code CLI(公式 feature)。CLI をグローバル導入し VS Code 拡張も追加。
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {},
    // GitHub CLI(公式 feature)。PR 作成・マージ等に使う(`gh auth login` は初回に実施)。
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  // ログイン状態(Cookie)を名前付き volume に永続化 → リビルドしても消えない。
  // 認証はマシンごとの秘密なのでイメージには焼き込まず、初回に login する。
  "mounts": [
    "source=atcoder-oj-config,target=/home/vscode/.config/online-judge-tools,type=volume",
    "source=atcoder-oj-data,target=/home/vscode/.local/share/online-judge-tools,type=volume",
    "source=atcoder-acc-config,target=/home/vscode/.config/atcoder-cli-nodejs,type=volume",
    // Claude Code のログイン情報・設定を永続化(リビルドで再ログイン不要)
    "source=atcoder-claude,target=/home/vscode/.claude,type=volume",
    // Codex CLI のログイン情報・設定を永続化(リビルドで再ログイン不要)
    "source=atcoder-codex,target=/home/vscode/.codex,type=volume",
    // gh(GitHub CLI)の認証情報を永続化(リビルドで再ログイン不要)
    "source=atcoder-gh-config,target=/home/vscode/.config/gh,type=volume"
  ],

  // コンテナ生成時のセットアップ(chown / acc 設定 / gem)は post-create.sh に集約。
  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "Shopify.ruby-lsp"
      ],
      // ruby feature は RVM で Ruby を入れる。空の rbenv が同居しており拡張が
      // 誤検出して活性化に失敗するため、RVM を明示する(コンテナ限定設定)。
      "settings": {
        "rubyLsp.rubyVersionManager": {
          "identifier": "rvm"
        }
      }
    }
  },

  "remoteUser": "vscode"
}
